<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">
  <link rel="stylesheet" href="/css/style.css">
  {% if 'class="katex"' in content %}<link rel="stylesheet" href="/css/katex/katex.min.css">{% endif %}
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ metadata.title }}">
</head>
<body>
  <header class="site-header">
    <a class="site-title" href="/">{{ metadata.title }}</a>
    <nav>
      {% for tag in collections.tagList %}<a href="/tags/{{ tag | slugify }}/"{% if page.url == "/tags/" + (tag | slugify) + "/" %} aria-current="page"{% endif %}>{{ tag }}</a>{% endfor %}
      <a href="/feed.xml">feed</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    {{ metadata.author }} · <a href="/feed.xml">RSS</a>
  </footer>
</body>
</html>
