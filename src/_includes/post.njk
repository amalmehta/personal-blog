---
layout: base.njk
---
<article class="post">
  <header>
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      · {{ content | readingTime }}
      {% for tag in tags | sectionTags %}· <a href="/tags/{{ tag | slugify }}/">{{ tag }}</a> {% endfor %}
    </p>
  </header>
  {{ content | safe }}
</article>
<p class="back"><a href="/">← All posts</a></p>
